{
	"name": "wisim",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "$(cd ../wisim-backend/wasm && GOOS=js GOARCH=wasm go build -o main.wasm main.go && cd ../../ && cp wisim-backend/wasm/main.wasm wisim-nouveau/static/main.wasm) && $(cd ../wisim-backend/server && go build wisimserver.go && ./wisimserver 8000 10 1) & vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@fontsource/fira-mono": "^5.0.0",
		"@neoconfetti/svelte": "^2.0.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/enhanced-img": "^0.8.3",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.25.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"@neodrag/svelte": "^3.0.0-next.8",
		"@picocss/pico": "^2.1.1",
		"echarts": "^6.0.0"
	}
}
